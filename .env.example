NODE_ENV=development
PORT=3000

API_PREFIX=api
API_VERSION=1

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false

BODY_LIMIT=1mb
TRUST_INCOMING_REQUEST_ID=true

# Aplicación expuesta directamente
TRUST_PROXY=

# Proxy ejecutándose en la misma máquina
TRUST_PROXY=loopback

# Ejemplo con una red explícita
TRUST_PROXY=10.10.0.0/16

# Varias fuentes confiables
TRUST_PROXY=loopback,10.10.0.0/16

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Application identity
APP_NAME=backend-base
APP_VERSION=0.0.0
NODE_ENV=development

# Container
HOST_PORT=3000